{
  "name": "operator",
  "version": "0.0.0",
  "private": true,
  "description": "Operator: a number puzzle with targets on rows and columns.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build && vite preview --open",
    "build": "vite build",
    "catalogue": "vite build --mode catalogue && vite preview --outDir catalogue-dist --open /catalogue.html",
    "build:catalogue": "vite build --mode catalogue",
    "build:flags-on": "vite build --mode flags-on",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json && tsc --project src/engine/tsconfig.json && tsc --project test/acceptance/tsconfig.json && tsc --project tools/tsconfig.json",
    "test": "vitest run --coverage",
    "exceptions:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/run-exceptions-check.ts",
    "tests:guard": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/run-test-guard.ts",
    "test-results": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/run-test-results.ts",
    "test:acceptance":"npm run test:acceptance:engine && npm run test:acceptance:ui",
    "typecheck:acceptance": "tsc --project test/acceptance/tsconfig.json && tsc --project tools/tsconfig.json",
    "test:acceptance:engine": "node tools/run-acceptance.mjs engine",
    "test:acceptance:ui": "node tools/run-acceptance.mjs ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
